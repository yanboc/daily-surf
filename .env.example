# 配置说明：所有值均为 UTF-8 文本。
# 本地运行：复制本文件为 .env 并填写。
# GitHub Actions 云端运行：无需 .env，在仓库 Settings → Secrets 配置同名变量即可。

# Cursor Agent
CURSOR_API_KEY=replace_with_cursor_api_key

# SMTP
SMTP_HOST=smtp.126.com
SMTP_PORT=465
SMTP_USER=replace_with_sender@example.com
SMTP_PASS=replace_with_smtp_authorization_code
SMTP_FROM=replace_with_sender@example.com

# 飞书多维表格
FEISHU_APP_ID=replace_with_app_id
FEISHU_APP_SECRET=replace_with_app_secret
FEISHU_APP_TOKEN=replace_with_bitable_app_token
